# Forge Environment Configuration Example

# Primary Model Configuration (GLM 5.2)
GLM_ENDPOINT=http://localhost:8000/v1
GLM_BASE_URL=http://localhost:8000/v1
GLM_API_KEY=local-sk-key

# Secondary Model Configuration (Kimi K2.5)
KIMI_ENDPOINT=http://localhost:8001/v1
KIMI_BASE_URL=http://localhost:8001/v1
KIMI_API_KEY=local-sk-key

# Defaults
FORGE_PRIMARY_MODEL=glm
FORGE_SAFE_MODE=true
FORGE_DRIVE_VAULT_PATH=/content/drive/MyDrive/AI Model Vault
