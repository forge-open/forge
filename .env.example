# Forge Environment Configuration

# Inference Endpoint Configuration
FORGE_BASE_URL=http://localhost:8000/v1
FORGE_MODEL=
FORGE_TEMPERATURE=0.1
FORGE_MAX_TOKENS=2048
FORGE_SAFE_MODE=true

# Remote GPU Lifecycle Configuration (Lightning AI)
FORGE_REMOTE_PROVIDER=lightning
FORGE_LIGHTNING_STUDIO=forge-qwen
FORGE_LIGHTNING_GPU=NVIDIA L40S 48 GB
FORGE_REMOTE_PORT=8000

# Optional Lightning Authentication (DO NOT COMMIT REAL API KEYS HERE)
# LIGHTNING_API_KEY=
# FORGE_LIGHTNING_API_KEY=
# FORGE_LIGHTNING_TEAMSPACE=
# FORGE_LIGHTNING_USER=

# Automation Controls
FORGE_REMOTE_AUTO_START=true
FORGE_REMOTE_AUTO_STOP=true
FORGE_REMOTE_STARTUP_TIMEOUT=300
FORGE_REMOTE_RETRY_INTERVAL=3
